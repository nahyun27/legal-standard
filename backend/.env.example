# local | production — production 이면 개발용 로그인이 꺼지고, 기본 JWT 시크릿으로는 기동하지 않는다.
ENV=local

DATABASE_URL=postgresql+psycopg2://legal:legal1234@localhost:5434/legal_standard

# 반드시 긴 랜덤값으로. 생성: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=please-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# https 로 서비스 중이면 true. 로컬(http)에서는 false 여야 브라우저가 쿠키를 저장한다.
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]

FRONTEND_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8002

# 소셜 로그인. 비어 있는 provider 는 로그인 화면에서 "준비 중"으로 표시된다.
# 각 개발자 콘솔에 Redirect URI 로 {BACKEND_BASE_URL}/api/v1/auth/social/{kakao|naver}/callback 을 등록할 것.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 개발용 로그인(이름만 넣으면 로그인). ENV=production 에서는 이 값과 무관하게 항상 꺼진다.
DEV_LOGIN_ENABLED=true

# 토스페이먼츠. 시크릿 키가 비면 시뮬레이션(바로 결제완료). 운영(ENV=production)은 키 없이 기동하지 않는다.
# 토스 개발자센터 웹훅 URL: {BACKEND_BASE_URL}/api/v1/payments/webhook (결제 상태 변경)
TOSS_SECRET_KEY=
TOSS_CLIENT_KEY=

# 사건 파일 저장 위치(공개 경로 금지)·업로드 한도
STORAGE_DIR=storage
MAX_UPLOAD_MB=20

# 실비 단가 — 오픈 전 법원 송달료 고시·우체국 요금으로 확인
COURT_SERVICE_UNIT_KRW=5500
CERTIFIED_LETTER_POSTAGE_KRW=5000

# 운영 규칙
MAX_OPEN_CASES_PER_LAWYER=40
PENDING_REMIND_HOURS=24
PENDING_EXPIRE_DAYS=7
PUBLIC_METRICS_MIN_CASES=30
CONSENT_VERSION=2026-10-draft

# 관리자 2단계 인증 — 운영 환경에서는 이 값과 무관하게 항상 켜진다
ADMIN_MFA_REQUIRED=false
ADMIN_MFA_HOURS=12

# 알림: SMS(솔라피, 발신번호 사전 등록 필요) → 이메일. 비어 있으면 발송 없이 기록만 남긴다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SMS_SENDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 국가법령정보센터 Open API 인증값(OC) — 인용 판례·법령 실존 확인
LAW_API_OC=
