# local | production — production 이면 개발용 로그인이 꺼지고, 기본 JWT 시크릿으로는 기동하지 않는다.
ENV=local

DATABASE_URL=postgresql+psycopg2://legal:legal1234@localhost:5434/legal_standard

# 반드시 긴 랜덤값으로. 생성: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=please-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# https 로 서비스 중이면 true. 로컬(http)에서는 false 여야 브라우저가 쿠키를 저장한다.
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]

FRONTEND_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8002

# 소셜 로그인. 비어 있는 provider 는 로그인 화면에서 "준비 중"으로 표시된다.
# 각 개발자 콘솔에 Redirect URI 로 {BACKEND_BASE_URL}/api/v1/auth/social/{kakao|naver}/callback 을 등록할 것.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 개발용 로그인(이름만 넣으면 로그인). ENV=production 에서는 이 값과 무관하게 항상 꺼진다.
DEV_LOGIN_ENABLED=true
