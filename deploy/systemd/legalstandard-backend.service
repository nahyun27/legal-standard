# /etc/systemd/system/legalstandard-backend.service
[Unit]
Description=Legal Standard backend (FastAPI)
After=network.target postgresql.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/legal-standard/backend
# 설정은 backend/.env (ENV=production). 127.0.0.1 에서만 받는다 — 바깥에서는 Next(/api/v1)를 거쳐야 한다.
# --forwarded-allow-ips 기본값(127.0.0.1)이라 Next 가 넘긴 접속자 IP 만 믿는다.
ExecStart=/home/ubuntu/legal-standard/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8002 --workers 2 --proxy-headers
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
