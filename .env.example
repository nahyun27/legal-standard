# 공개 주소 (메타태그·sitemap 기준)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 검색엔진 색인 허용. 기본은 차단(noindex). 광고심사위 사전 질의 회신 후 정식 오픈할 때만 true
NEXT_PUBLIC_ALLOW_INDEXING=false

# 대외 카피 트랙 (사업기획서 VIII장)
#   B = 변호사 검토·서명·책임 표방 (론칭안, 기본값)
#   A = 공인 AI + 변호사 책임 표방 — 변협 AI 인증·등록 취득 후에만 A 로 바꾼다
NEXT_PUBLIC_COPY_TRACK=B

# 백엔드 주소 — 브라우저는 같은 주소의 /api/v1 을 부르고 Next 가 여기로 넘긴다(src/app/api/v1/[...path]/route.ts)
API_PROXY_TARGET=http://127.0.0.1:8002
# 같은 와이파이의 다른 기기로 개발 서버를 열 때 추가로 허용할 주소(이 컴퓨터의 LAN IP 는 자동 허용)
# DEV_ORIGINS=my-mac.local
